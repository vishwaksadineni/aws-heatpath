# HeatPath Environment Variables
# Copy this to .env and fill in your values

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# DynamoDB Table Names (created by setup script)
DYNAMODB_TABLE_WATER_POINTS=heatpath-water-points
DYNAMODB_TABLE_CACHE=heatpath-route-cache

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# No keys needed for:
# - Open-Meteo (free, no key)
# - OSRM public demo server (free, no key)
# - Overpass API (free, no key)
